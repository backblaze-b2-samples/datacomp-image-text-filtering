# Backblaze B2 (required) — S3-compatible API credentials.
# Create an application key + bucket at https://secure.backblaze.com/b2_buckets.htm
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region slug only (e.g. us-west-004). The S3 endpoint is built at runtime as
# https://s3.<B2_REGION>.backblazeb2.com — there is no hardcoded region default.
B2_REGION=your_b2_region

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K005-your-application-key-here
# B2_BUCKET_NAME=my-datacomp-pool
# B2_REGION=us-west-004

# Optional: public base URL for a *public* bucket, used to build direct object
# URLs. Leave commented for a private bucket (the app works without it).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
